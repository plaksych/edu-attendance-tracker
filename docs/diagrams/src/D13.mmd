flowchart TB
  demo["Демо без регистрации"] --> fixtures["Учебные данные: demo_fixture"]
  demo --> own["Свой разрешённый файл: browser inference"]
  own --> result["Результат / ошибка / отмена; без отправки файла"]
  live["Рабочий режим: вход"] --> upload["Серверная загрузка с правами"]
  upload --> queue["Очередь; ожидание реального worker"]
  queue --> detail["Число, кадр, происхождение и история"]
  detail --> link["Upload: optional session_id / measurement_id"]
  link --> report["measurement_id без capture: scheduler агрегирует открытый замер"]
  report -.-> limitation["session_id без замера и retry закрытого итога не пересчитывают attendance"]
  live --> session["Занятие: замеры и partial / complete / failed"]
  session --> analytics["Аналитика; экспорт доступного набора"]
  live --> schedule["Расписание: XLSX"]
  schedule --> preview["UI + API: preview, ошибки и TTL 30 минут"]
  preview --> confirm["Confirm владельцем, повторная проверка конфликтов"]
  confirm --> saved["Расписание применено атомарно; legacy import возвращает 409"]
  note["Пунктир: ограничение или требуемая проверка, не реализованный сквозной переход."]
