# Separate operator file, outside repository; chmod 600. No live credentials.
OPS_MODE=restore
OPS_NAMESPACE=attendance-restore-drill
OPS_INSTANCE_ID=
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=attendance_restore_drill
PGUSER=restore_owner
PGPASSFILE=/secure/attendance/restore.pgpass
PGSSLMODE=disable
# Non-loopback connections require verify-full and PGSSLROOTCERT.
S3_ENDPOINT=127.0.0.1:19000
S3_SECURE=false
S3_BUCKET=attendance-restore-drill
S3_ACCESS_KEY=
S3_SECRET_KEY=
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/secure/attendance/restic-password
# Backend credentials for restic (not the application S3 account).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_STAGING_DIR=/secure/encrypted-staging
BACKUP_STAGING_ENCRYPTED=false
