limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_certificate /run/secrets/tls_crt;
    ssl_certificate_key /run/secrets/tls_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 444;
}
server {
    listen 8443 ssl;
    server_name ${APP_HOST};
    ssl_certificate /run/secrets/tls_crt;
    ssl_certificate_key /run/secrets/tls_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 100m;
    client_body_timeout 30s;
    send_timeout 30s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' blob: data: https://${MEDIA_HOST}:${HTTPS_PORT}; media-src 'self' blob: https://${MEDIA_HOST}:${HTTPS_PORT}; connect-src 'self' https://${MEDIA_HOST}:${HTTPS_PORT}; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'" always;
    # Signed URLs and sensitive query parameters must not reach access logs.
    access_log off;
    location = /api/v1/auth/login {
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 15s;
    }
    location / {
        proxy_pass http://frontend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
    location = /health/ready {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
    }
}
server {
    listen 8443 ssl;
    server_name ${MEDIA_HOST};
    ssl_certificate /run/secrets/tls_crt;
    ssl_certificate_key /run/secrets/tls_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    add_header X-Content-Type-Options nosniff always;
    location / {
        limit_except GET HEAD { deny all; }
        proxy_pass http://minio:9000;
        proxy_set_header Host $http_host;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
