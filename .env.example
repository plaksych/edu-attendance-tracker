# Template only. Store the filled file OUTSIDE git, chmod 600; no shell interpolation.
# Empty secrets/images intentionally fail validation. No default credentials.
ENVIRONMENT=production
COMPOSE_PROJECT_NAME=attendance-prod-campus
DB_NAME=attendance_prod_campus
DB_ADMIN_USER=attendance_owner
DB_ADMIN_PASSWORD=
# URL-encode passwords. All DSNs target db:5432/attendance_prod_campus.
# Use four separate roles, distinct from DB_ADMIN_USER, prefixed attendance_prod_campus_.
# Example suffixes: api, migrate, recognition, capture. Use role-init before migrations.
# Runtime roles cannot own schema or ops_control; role-grants follows migrations/restore.
BACKEND_DATABASE_URL=
MIGRATION_DATABASE_URL=
RECOGNITION_DATABASE_URL=
CAPTURE_DATABASE_URL=

# Use reviewed immutable registry/image@sha256:<64 hex> artifacts.
# PostgreSQL image must use Debian uid 999 and PGDATA /var/lib/postgresql/data.
POSTGRES_IMAGE=
MINIO_IMAGE=
GATEWAY_IMAGE=
BACKEND_IMAGE=
FRONTEND_IMAGE=
RECOGNITION_IMAGE=
CAPTURE_IMAGE=

APP_HOST=attendance.example.invalid
MEDIA_HOST=media.example.invalid
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
TLS_CERT_FILE=/secure/attendance/fullchain.pem
TLS_KEY_FILE=/secure/attendance/privkey.pem

MINIO_BUCKET=attendance-prod-campus
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_INIT_ACCESS_KEY=
MINIO_INIT_SECRET_KEY=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
ORIGINAL_RETENTION_DAYS=30
ANNOTATED_RETENTION_DAYS=90

# Fernet key; keep escrow separately from media backup. No auto-generated default.
CAMERA_ENCRYPTION_KEY=
CAMERA_ALLOWED_CIDRS=
CAPTURE_GROUP=default
DEMO_RESET_ENABLED=false
TIMEZONE=Europe/Moscow
SEMESTER_START=2026-09-01
SEMESTER_END=2027-01-31
MEASUREMENT_INPUT_GRACE_SECONDS=3600
MODEL_FILE=/secure/attendance/models/model.pt
MODEL_SHA256=
RECOGNITION_MODEL_NAME=yolov8n
RECOGNITION_MODEL_VERSION=
