{
  "name": "attendance-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_STATIC_DATA=true vite",
    "typecheck": "tsc -b",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-build.mjs",
    "generate:api": "node scripts/generate-contract.mjs",
    "check:api": "node scripts/generate-contract.mjs --check && tsc -p tsconfig.contract.json",
    "check:demo-build": "node scripts/check-demo-build.mjs",
    "build:demo": "VITE_STATIC_DATA=true vite build --base=/edu-attendance-tracker/ --outDir dist-demo",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.1.4",
    "vitest": "^5.0.1"
  }
}
